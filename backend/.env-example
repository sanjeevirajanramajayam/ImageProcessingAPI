NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=imageprocessing
DATABASE_URL="mysql://root:1234@localhost:3306/imageprocessing"

REDIS_URL="redis://localhost:6379"

# S3 / Object Storage configuration
BUCKET_NAME="z-image-processing-storage"
BUCKET_REGION="eu-north-1"
ACCESS_KEY="access-key"
SECRET_ACCESS_KEY="secret-key"

# Leave S3_ENDPOINT blank for AWS S3. Set to custom URL (e.g. MinIO) if using local/custom storage.
S3_ENDPOINT=""
PUBLIC_S3_ENDPOINT=""
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="password"
MINIO_REGION="us-east-1"

JWT_ACCESS_TOKEN='your-own-access-token'
JWT_REFRESH_TOKEN='your-own-refresh-token'